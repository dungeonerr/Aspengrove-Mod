{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"accessWidener": "aspengrove.accesswidener",
	"authors": [
		"Dungeonerr",
		"StarmanMine142"
	],
	"contact": {
		"homepage": "${homepage_link}",
		"sources": "${sources_link}",
		"issues": "${issues_link}"
	},
	"license": "${mod_license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dngnrr.aspengrove.AspenGrove"
		],
		"client": [
			"dngnrr.aspengrove.AspenGroveClient"
		]
	},
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"ohthetreesyoullgrow": "*",
		"biolith": "*"
	}
}
