{
  "schema_version": 1,
  "quilt_loader": {
    "group": "dngnrr.aspengrove",
    "id": "${mod_id}",
    "version": "${version}",
    "metadata": {
      "name": "${mod_name}",
      "description": "${mod_description}",
      "contributors": {
        "Dungeonerr": "Author",
        "StarmanMine142": "Author"
      },
      "contact": {
        "homepage": "${homepage_link}",
        "sources": "${sources_link}",
        "issues": "${issues_link}"
      },
      "license": "${mod_license}",
      "icon": "assets/aspengrove/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "main": "dngnrr.aspengrove.Aspengrove",
      "client": "dngnrr.aspengrove.AspengroveClient"
    },
    "depends": [
      {
        "id": "fabricloader",
        "versions": ">=${min_fabric_loader_version}"
      },
      {
        "id": "minecraft",
        "versions": "~${min_minecraft_version}"
      },
      {
        "id": "java",
        "versions": ">=${java_version}"
      },
      "fabric-api",
      "nbtfied_trees",
      "biolith"
    ]
  },
  "access_widener": "aspengrove.accesswidener"
}