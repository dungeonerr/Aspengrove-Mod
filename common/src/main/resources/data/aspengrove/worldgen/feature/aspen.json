{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based_state_provider",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "type": "minecraft:simple_state_provider",
          "state": "minecraft:dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "minecraft:attached_to_logs",
      "probability": 0.2,
      "block_provider": {
        "type": "minecraft:simple_state_provider",
        "state": "aspengrove:aspen_leaves"
      },
      "directions": ["north", "south", "east", "west"]
    },
    {
      "type": "minecraft:beehive",
      "probability": 0.002
    }
  ],
  "foliage_placer": {
    "type": "minecraft:cherry_foliage_placer",
    "height": 5,
    "corner_hole_chance": 0.85,
    "hanging_leaves_chance": 0.15,
    "hanging_leaves_extension_chance": 0.35,
    "wide_bottom_layer_hole_chance": 0.55,
    "offset": 0,
    "radius": 3
  },
  "foliage_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "aspengrove:aspen_leaves"
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size",
    "limit": 5,
    "lower_size": 0,
    "upper_size": 2
  },
  "trunk_placer": {
    "type": "minecraft:straight_trunk_placer",
    "base_height": 8,
    "height_rand_a": 1,
    "height_rand_b": 0

  },
  "trunk_provider": {
    "type": "minecraft:simple_state_provider",
    "state": "aspengrove:aspen_log"
  }
}